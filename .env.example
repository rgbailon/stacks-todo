# Stacks — AI chat configuration
# Copy to `.env` (gitignored), fill in, then restart `npm run dev` / `npm run tauri dev`.
# Values are embedded into the frontend bundle at build time — desktop/local use only.

# ── Anthropic (direct Messages API) ─────────────────────────────
ANTHROPIC_API_KEY=
# Optional model override:
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ── OpenCode (local v2 server) ──────────────────────────────────
# 1. Start the server with a password. Use the same value for the server and
#    the app: the app sends it as HTTP Basic (username `opencode`).
#    Add both origins so the desktop app and the dev preview can connect.
#    PowerShell (one line):
#      $env:OPENCODE_PASSWORD="your-secret"; opencode serve --port 4096 --cors tauri://localhost --cors http://localhost:1420
#    bash/zsh:
#      OPENCODE_PASSWORD=your-secret opencode serve --port 4096 --cors tauri://localhost --cors http://localhost:1420
# 2. Point Stacks at the URL the server prints:
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_PASSWORD=
# Optional model on that server, format providerID/modelID.
# Leave unset to use the model OpenCode has selected.
# OPENCODE_MODEL=anthropic/claude-sonnet-4-5
#
# List the models this server can use:
#   curl -u opencode:$OPENCODE_PASSWORD http://127.0.0.1:4096/api/model
