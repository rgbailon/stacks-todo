# Stacks — AI chat configuration
# Copy to `.env` (gitignored), fill in, then restart `npm run dev` / `npm run tauri dev`.
# Values are embedded into the frontend bundle at build time — desktop/local use only.

# ── Anthropic (direct Messages API) ─────────────────────────────
ANTHROPIC_API_KEY=
# Optional model override:
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ── OpenCode (local server wrapper) ─────────────────────────────
# 1. Start the server with a known password (the value both sides share):
#      OPENCODE_SERVER_PASSWORD=your-secret opencode serve --port 4096
#    Without it the server runs unsecured (any client can use it).
#    Extra web origins (e.g. a preview URL) need: --cors <origin>
# 2. Point the chat at the URL the server prints. OPENCODE_PASSWORD below
#    is what the app sends as HTTP Basic auth (username is always
#    `opencode`) — use the same value as OPENCODE_SERVER_PASSWORD.
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_PASSWORD=
# Optional model on that server, format providerID/modelID:
# OPENCODE_MODEL=anthropic/claude-sonnet-4-5
